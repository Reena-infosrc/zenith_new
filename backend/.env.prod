STAGE=prod
SERVICE_NAME=zenith-hr-pulse
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# AWS Configuration
AWS_REGION=us-east-1

# ECR Configuration (Production)
ECR_REGION=us-east-1
ECR_REPOSITORY=zenith-hr-pulse-prod
ECR_IMAGE_TAG=prod
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:383574875115:certificate/12db8b16-708b-4c53-bf1a-4bc18b178f6a

# DynamoDB Tables (Production - with -prod suffix)
DYNAMODB_TABLE_EMPLOYEES=zenith-hr-employees-prod
DYNAMODB_TABLE_USERS=zenith-hr-users-prod
DYNAMODB_TABLE_ADMIN=zenith-hr-admin-prod
DYNAMODB_TABLE_REVIEW=zenith-hr-review-prod
DYNAMODB_TABLE_REVIEW_DRAFT=zenith-hr-review-draft-prod
DYNAMODB_TABLE_CLIENT_SATISFACTION=zenith-hr-client-satisfaction-prod
DYNAMODB_TABLE_CLIENTS=zenith-hr-clients-prod
DYNAMODB_TABLE_COMPETENCIES=zenith-hr-competencies-prod
DYNAMODB_TABLE_CYCLE=zenith-hr-cycle-prod
DYNAMODB_TABLE_ENGAGEMENT_ACTIVITIES=zenith-hr-engagement-activities-prod
DYNAMODB_TABLE_RESOURCE_MAPPINGS=zenith-hr-resource-mappings-prod
DYNAMODB_TABLE_REVENUE_FORECASTS=zenith-hr-revenue-forecasts-prod
DYNAMODB_TABLE_GOALS=zenith-hr-goals-prod
DYNAMODB_TABLE_FEEDBACK=zenith-hr-feedback-prod
DYNAMODB_TABLE_RECRUITMENT=zenith-hr-recruitment-prod
DYNAMODB_TABLE_FEATURES=zenith-hr-feature-flags-prod
DYNAMODB_TABLE_CLIENT_RM_FEEDBACK=zenith-hr-client-rm-feedback-prod
DYNAMODB_TABLE_LEADERSHIP_ACCESS=zenith-hr-leadership-access-prod

# S3 Buckets (Production)
S3_BUCKET_PHOTOS=zenith-hr-pulse-photos-prod
S3_BUCKET_DOCUMENTS=zenith-hr-documents-prod
S3_BUCKET_DOMAIN=zenith-hr-prod.apps.infoservices.com
S3_REGION=us-east-1
S3_PHOTOS_PREFIX=profile-photos/

# AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# Application (Production)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Production)
CORS_ORIGINS=https://zenith-hr.example.com

# ECS Configuration (Production)
ECS_CLUSTER_NAME=zenith-hr-pulse-prod
ECS_TASK_FAMILY=zenith-hr-pulse-prod
ECS_SERVICE_NAME=zenith-hr-pulse-prod
ECS_DESIRED_COUNT=2
ECS_CPU=1024
ECS_MEMORY=2048

# VPC Configuration (Production)
VPC_CIDR=10.1.0.0/16
PUBLIC_SUBNET_1_CIDR=10.1.0.0/24
PUBLIC_SUBNET_2_CIDR=10.1.1.0/24
AWS_ACCOUNT_ID=383574875115

# DynamoDB field-level encryption (production: off until KMS + allowlist rollout)
DYNAMODB_FIELD_ENCRYPTION_ENABLED=false
DYNAMODB_FIELD_ENCRYPTION_KMS_KEY_ARN=
DYNAMODB_FIELD_ENCRYPTION_CONTEXT_APP=zenith-hr-pulse

# ALB Configuration (Production)
ALB_HEALTH_CHECK_PATH=/health
ALB_HEALTH_CHECK_INTERVAL=30
ALB_HEALTH_CHECK_TIMEOUT=10
ALB_HEALTHY_THRESHOLD=2
ALB_UNHEALTHY_THRESHOLD=5

# MongoDB (for migration)
MONGO_URI=mongodb+srv://user:password@cluster0.prod.mongodb.net/
MONGO_DB_NAME=hr_pulse_db_prod
