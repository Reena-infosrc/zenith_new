STAGE=staging
SERVICE_NAME=zenith-hr-pulse
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=info

# AWS Configuration
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=*** (pulled from GitHub secrets)

# ECR Configuration (Staging)
# ECR_ACCOUNT_ID=*** (pulled from GitHub secrets)
ECR_REGION=us-east-1
ECR_REPOSITORY=zenith-hr-pulse-staging
ECR_IMAGE_TAG=staging
# ECR_IMAGE_URI=*** (pulled from GitHub secrets)

# ACM Certificate (Staging)
# ACM_CERTIFICATE_ARN=*** (pulled from GitHub secrets)

# DynamoDB Tables (Staging - with -staging suffix)
DYNAMODB_TABLE_EMPLOYEES=zenith-hr-employees-staging
DYNAMODB_TABLE_USERS=zenith-hr-users-staging
DYNAMODB_TABLE_ADMIN=zenith-hr-admin-staging
DYNAMODB_TABLE_REVIEW=zenith-hr-review-staging
DYNAMODB_TABLE_REVIEW_DRAFT=zenith-hr-review-draft-staging
DYNAMODB_TABLE_CLIENT_SATISFACTION=zenith-hr-client-satisfaction-staging
DYNAMODB_TABLE_CLIENTS=zenith-hr-clients-staging
DYNAMODB_TABLE_COMPETENCIES=zenith-hr-competencies-staging
DYNAMODB_TABLE_CYCLE=zenith-hr-cycle-staging
DYNAMODB_TABLE_ENGAGEMENT_ACTIVITIES=zenith-hr-engagement-activities-staging
DYNAMODB_TABLE_RESOURCE_MAPPINGS=zenith-hr-resource-mappings-staging
DYNAMODB_TABLE_REVENUE_FORECASTS=zenith-hr-revenue-forecasts-staging
DYNAMODB_TABLE_GOALS=zenith-hr-goals-staging
DYNAMODB_TABLE_FEEDBACK=zenith-hr-feedback-staging
DYNAMODB_TABLE_RECRUITMENT=zenith-hr-recruitment-staging
DYNAMODB_TABLE_FEATURES=zenith-hr-feature-flags-staging

# S3 Buckets (Staging)
S3_BUCKET_PHOTOS=zenith-hr-pulse-photos-staging
S3_BUCKET_DOCUMENTS=zenith-hr-documents-staging
S3_BUCKET_DOMAIN=zenith-hr-staging.apps.infoservices.com
S3_REGION=us-east-1
S3_PHOTOS_PREFIX=profile-photos/

# AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# Application (Staging)
# SECRET_KEY=*** (pulled from GitHub secrets)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Staging)
CORS_ORIGINS=https://staging.zenith-hr.example.com,http://localhost:3000,http://localhost:8080

# ECS Configuration (Staging)
ECS_CLUSTER_NAME=zenith-hr-pulse-staging
ECS_TASK_FAMILY=zenith-hr-pulse-staging
ECS_SERVICE_NAME=zenith-hr-pulse-staging
ECS_DESIRED_COUNT=1
ECS_CPU=512
ECS_MEMORY=1024

# VPC Configuration (Staging)
VPC_CIDR=10.0.0.0/16
PUBLIC_SUBNET_1_CIDR=10.0.0.0/24
PUBLIC_SUBNET_2_CIDR=10.0.1.0/24

# ALB Configuration (Staging)
ALB_HEALTH_CHECK_PATH=/health
ALB_HEALTH_CHECK_INTERVAL=30
ALB_HEALTH_CHECK_TIMEOUT=10
ALB_HEALTHY_THRESHOLD=2
ALB_UNHEALTHY_THRESHOLD=5

# MongoDB (for migration)
MONGO_URI=mongodb+srv://user:password@cluster0.staging.mongodb.net/
MONGO_DB_NAME=hr_pulse_db_staging