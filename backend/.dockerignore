# Ignore Python cache and venv
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.log
*.db

# Ignore local virtualenvs
venv/
.env/
.env.*
.venv/
env/
ENV/

# Ignore node and build artifacts (Serverless CLI deps are CI-only, not in the API image)
node_modules/
package.json
package-lock.json
dist/
build/
.cache/
coverage/

# Ignore Serverless build directories
.serverless/
.aws-sam/

# Ignore IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore layer sources (we’re using Docker now)
layer/