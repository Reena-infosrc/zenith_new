# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.serverless/

# Env files: ignore everything under this pattern, never allowlist by name
# (a per-file list here is how .env.prod stayed untracked-but-not-really and
# ended up committed). Keep only .env.example tracked as the documented template.
.env*
!.env.example

# Compiled Python: blanket-ignore every __pycache__ dir and .pyc, anywhere in
# the tree. A per-directory allowlist here previously missed new directories
# (routers/, scripts/) every time one was added, leaving the working tree
# permanently dirty.
__pycache__/
*.pyc

backend/layer/
backend/layer/requirements.txt
.requirements.zip